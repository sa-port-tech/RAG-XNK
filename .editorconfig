# Quy tắc định dạng mã — nguồn sự thật cho `dotnet format`.
#
# Vì sao file này phải tồn tại TRƯỚC file .cs đầu tiên: ci-dotnet chạy
# `dotnet format --verify-no-changes` trên toàn solution. Không có .editorconfig thì
# quy tắc áp dụng là mặc định của SDK — thay đổi theo phiên bản SDK, không ai chọn,
# và mọi PR về sau phải sống chung với nó.
#
# Ngưỡng nghiêm ngặt của trình biên dịch nằm ở src/dotnet/Directory.Build.props.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.{sh,bash}]
end_of_line = lf
indent_size = 2

[*.md]
# Markdown dùng hai dấu cách cuối dòng để xuống dòng cứng.
trim_trailing_whitespace = false

[*.cs]

# ─── using ───────────────────────────────────────────────────────────────────────
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:error

# ─── namespace ───────────────────────────────────────────────────────────────────
# File-scoped namespace: bớt một cấp thụt lề trên mọi file, và không có lựa chọn thứ
# hai để tranh luận trong review.
csharp_style_namespace_declarations = file_scoped:error

# ─── this. ───────────────────────────────────────────────────────────────────────
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# ─── kiểu và var ─────────────────────────────────────────────────────────────────
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# ─── biểu thức ───────────────────────────────────────────────────────────────────
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion

# ─── null ────────────────────────────────────────────────────────────────────────
# Dự án bật <Nullable>enable</Nullable>; các quy tắc dưới đây giữ cho ý định về null
# hiện ra ở cú pháp thay vì nằm trong đầu người viết.
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
csharp_style_conditional_delegate_call = true:warning

# ─── readonly & const ────────────────────────────────────────────────────────────
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion

# ─── dấu ngoặc nhọn ──────────────────────────────────────────────────────────────
# Luôn có ngoặc nhọn kể cả thân một dòng. Đây không phải thẩm mỹ: thân không ngoặc là
# nguồn của cả một lớp lỗi khi ai đó thêm dòng thứ hai vào sau này.
csharp_prefer_braces = true:error

# ─── khoảng trắng & xuống dòng ───────────────────────────────────────────────────
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_preserve_single_line_blocks = true

# ─── quy ước đặt tên ─────────────────────────────────────────────────────────────
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal.required_prefix = I
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.severity = error
dotnet_naming_rule.types_are_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_are_pascal_case.style = pascal
dotnet_naming_symbols.type_symbols.applicable_kinds = class,struct,enum,delegate
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.members_are_pascal_case.severity = warning
dotnet_naming_rule.members_are_pascal_case.symbols = member_symbols
dotnet_naming_rule.members_are_pascal_case.style = pascal
dotnet_naming_symbols.member_symbols.applicable_kinds = property,method,event
dotnet_naming_symbols.member_symbols.applicable_accessibilities = public,internal,protected

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# ─── mã do EF Core sinh ──────────────────────────────────────────────────────────
#
# `dotnet ef migrations add` sinh file theo khuôn của chính nó: namespace kiểu cũ, xuống
# dòng CRLF, có BOM. Chúng vi phạm quy tắc bên trên, và chỉnh tay thì lần sinh sau lại
# hỏng — một vòng lặp không có điểm dừng.
#
# `generated_code = true` cho `dotnet format` và bộ phân tích biết đây là mã sinh ra và
# bỏ qua. Điều này KHÔNG làm giảm mức soi xét khi review: nội dung migration vẫn phải đọc
# kỹ, chỉ là đọc phần SQL nó tạo ra chứ không phải phần dấu ngoặc.
[**/Data/Migrations/*.cs]
generated_code = true

# ─── phân tích tĩnh ──────────────────────────────────────────────────────────────
# CA2007 (ConfigureAwait) tắt có chủ đích: ASP.NET Core không có SynchronizationContext,
# nên .ConfigureAwait(false) chỉ thêm nhiễu vào mọi dòng await mà không đổi hành vi.
dotnet_diagnostic.CA2007.severity = none
# CA1848 (LoggerMessage delegate) là tối ưu hiệu năng đường nóng; bật cả repo lúc chưa
# có nghiệp vụ nào chỉ tạo ra hàng loạt cảnh báo phải bịt.
dotnet_diagnostic.CA1848.severity = none
