# Tham số cho toàn bộ script trong .github/setup/.
#
# Đây là nơi duy nhất chứa tên tổ chức, tên repo và các lựa chọn chính sách. Không
# script nào được viết cứng các giá trị này — đổi tên org phải là sửa một dòng ở đây.

# ─── Danh tính ────────────────────────────────────────────────────────────────
ORG="sa-port-tech"
REPO="RAG-XNK"
DEFAULT_BRANCH="main"
VISIBILITY="public"

PROJECT_TITLE="RAG XNK — Prototype"

# ─── Chính sách nhánh ─────────────────────────────────────────────────────────
# Số approval tối thiểu cho mọi PR (docs/01 §5.2). Mức 2 cho infra/ và db/migrations/
# do workflow pr-governance thực thi, cấu hình ở .github/quality-gates.yml.
REQUIRED_APPROVALS=1

# Bắt buộc ký commit (docs/00 §8.4).
# ⚠️ Bật cái này thì mọi thành viên phải cấu hình ký commit bằng GPG hoặc SSH trước,
#    nếu không họ sẽ bị chặn push với thông báo khó hiểu. Xem docs/17 §3.
REQUIRE_SIGNED_COMMITS=true

# ⚠️ CỜ TẠM THỜI — TẮT NGAY KHI CÓ NGƯỜI THỨ HAI ⚠️
#
# Ruleset bật "require review from Code Owners". Khi org mới có một người, người đó
# vừa là tác giả PR vừa là code owner duy nhất — GitHub không cho tự duyệt PR của
# mình, nên KHÔNG PR NÀO MERGE ĐƯỢC. Cờ này cho phép chủ sở hữu org bỏ qua luật khi
# merge PR (vẫn không được push thẳng vào main).
#
# Đây là lối thoát cho giai đoạn dựng nền, không phải một lựa chọn kiến trúc.
# Script 99-verify.sh sẽ báo cảnh báo chừng nào nó còn true.
BOOTSTRAP_ADMIN_BYPASS=true

# ─── Status check bắt buộc ────────────────────────────────────────────────────
# Đây là tên JOB (không phải tên workflow). Mỗi workflow có đúng một job tổng hợp
# trùng tên workflow, luôn chạy và luôn báo cáo — nhờ vậy required check không bị
# treo vĩnh viễn khi path filter bỏ qua toàn bộ job bên trong.
REQUIRED_CHECKS=(
  "ci-dotnet"
  "ci-python"
  "ci-blazor"
  "ci-bpmn"
  "eval-regression"
  "pr-governance"
  "codeql"
)

# ─── Môi trường triển khai ────────────────────────────────────────────────────
# Prototype chỉ dùng dev. staging và production được tạo sẵn với luật duyệt đầy đủ
# để Phase 1 không phải dựng lại, nhưng chưa bật (ENABLE_STAGING/ENABLE_PRODUCTION).
ENVIRONMENTS=("dev" "staging" "production")

AWS_REGION="ap-southeast-1"

# Team được quyền duyệt deploy lên production. Phải là slug team đã tạo ở 02-teams.sh.
PRODUCTION_REVIEWER_TEAMS=("devops-lead" "tech-lead" "product-owner")

# Thời gian chờ trước khi deploy production bắt đầu, tính bằng phút. Khoảng lặng này
# để ai đó kịp bấm huỷ khi nhận ra vừa duyệt nhầm.
PRODUCTION_WAIT_TIMER=5
