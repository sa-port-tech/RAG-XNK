<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    identity-tenant — xác thực, tổ chức, người dùng, RBAC (docs/00 §4.2).
    Sở hữu schema `identity`.

    Đây là service DUY NHẤT phát JWT. Sáu service còn lại chỉ kiểm tra token, và phần kiểm
    tra đó nằm chung ở Xnk.Shared để không service nào tự nới lỏng tham số xác thực.

    Khai báo trong .github/services.json: cổng 8080, healthcheck /health/ready.
  -->

  <PropertyGroup>
    <RootNamespace>Xnk.IdentityTenant</RootNamespace>
    <UserSecretsId>xnk-identity-tenant-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Phát token. Khai tường minh vì đây là phụ thuộc bậc nhất của service này. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Xnk.Shared/Xnk.Shared.csproj" />
  </ItemGroup>

</Project>
