# Bản mẫu biến môi trường cho máy local. Chép thành `.env` rồi sửa theo máy mình.
#
# `.env` nằm trong .gitignore; file `.env.example` này thì được commit.
#
# ⚠️ KHÔNG đặt giá trị thật vào file này. Ở dev/staging/production, mọi bí mật đến từ AWS
# Secrets Manager và được tiêm vào task definition (docs/00 §12) — không có secret nào
# nằm ở biến môi trường dạng chữ thường hay trong repo.

# ─── Cổng vào ────────────────────────────────────────────────────────────────────
# Cổng trên MÁY để gọi vào nginx. Bên trong container luôn là 8080.
# Đổi nếu 8080 đã bị chiếm — kiểm tra bằng: netstat -ano | findstr :8080
XNK_HTTP_PORT=8080

# ─── PostgreSQL ──────────────────────────────────────────────────────────────────
#
# ⚠️ File này chứa giá trị cho các service CHẠY TRONG CONTAINER, nên tên host là
# `postgres` (tên service trong docker-compose), không phải `localhost`.
#
# Chạy `dotnet run` hay `uv run` thẳng trên máy thì KHÔNG dùng file này — lúc đó cấu hình
# đến từ `appsettings.Development.json` (bên .NET), nơi tên host là `localhost`. Hai ngữ
# cảnh, hai nguồn cấu hình, mỗi nguồn đúng cho ngữ cảnh của nó.
#
# Mỗi service nối bằng VAI TRÒ RIÊNG, không phải `postgres` (docs/00 §4.4). Vai trò và
# quyền được tạo bởi `db/roles.sql`; chạy `db/bootstrap-local.sh` một lần là có.
XNK_CORPUS_CONNECTION=Host=postgres;Port=5432;Database=xnk;Username=xnk_corpus;Password=xnk-local-corpus
XNK_IDENTITY_CONNECTION=Host=postgres;Port=5432;Database=xnk;Username=xnk_identity;Password=xnk-local-identity

# `retrieval` chỉ được ĐỌC schema `corpus` — ngoại lệ có chủ đích của §4.4, chốt ở ADR-012.
DATABASE_URL=postgres://xnk_retrieval:xnk-local-retrieval@postgres:5432/xnk

# ─── Test ────────────────────────────────────────────────────────────────────────
# Đặt biến này thì PostgresFixture dùng database có sẵn thay vì tự khởi Testcontainers.
# Bỏ trống ở máy dev là hợp lý: `dotnet test` sẽ tự dựng container đúng ảnh mà CI dùng.
# XNK_TEST_CONNECTION=Host=localhost;Port=5432;Database=xnk_test;Username=postgres;Password=xnk-local-dev

# ─── JWT ─────────────────────────────────────────────────────────────────────────
# Prototype dùng JWT đối xứng cho cả ba loại tenant (docs/00 §12). Tối thiểu 32 ký tự.
XNK_JWT_ISSUER=https://identity.xnk.local
XNK_JWT_AUDIENCE=xnk-api
XNK_JWT_SIGNING_KEY=khoa-ky-chi-dung-cho-may-local-khong-phai-bi-mat-32

# ─── AWS (LocalStack, profile "aws") ─────────────────────────────────────────────
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─── OpenTelemetry (Jaeger, profile "tracing") ───────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=xnk-local
